  "exports": {
    "Sayac": { "type": "durable-object", "storage": "sqlite" }
  },
  "routes": [
    { "pattern": "cananahtarcilingir.com", "custom_domain": true },
    { "pattern": "www.cananahtarcilingir.com", "custom_domain": true }
  ],
  // Geçici *.workers.dev adresi kapalı
  "workers_dev": false,
  "preview_urls": false
}
